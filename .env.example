# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cold_chain_monitoring_db

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Configuration
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME="Cold Chain Monitoring System"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Virtual Sensor Simulation
SIMULATION_RANDOM_SEED=20261022
SIMULATION_INTERVAL_MINUTES=5
SIMULATION_DEFAULT_SHIPMENT_COUNT=1000
SIMULATION_DEFAULT_CONTAINER_COUNT=300
